# ==============================================================================
# Kandezhuthu AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.

# ------------------------------------------------------------------------------
# 1. Google GenAI / Vertex AI Configuration
# ------------------------------------------------------------------------------
# Production Cloud Run / Vertex AI (Recommended):
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Google AI Studio API:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 2. Server & Cloud Run Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Production Public URL for A2A Agent Card and RPC callbacks:
# e.g. https://kandezhuthu-agent-uc.a.run.app
APP_URL=http://0.0.0.0:8000

# CORS Allowed Origins (comma-separated or wildcard):
ALLOW_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Database & Concurrency Settings
# ------------------------------------------------------------------------------
# SQLite database path (WAL mode automatically active with 30s busy timeout):
KANDEZ_DB_PATH=kandezhuthu.db

# ------------------------------------------------------------------------------
# 4. A2A (Agent-to-Agent) & Telemetry Settings
# ------------------------------------------------------------------------------
AGENT_VERSION=0.1.0
A2A_RPC_PATH=/a2a/kandezhuthu

# Set to true if running in an environment without Cloud Trace IAM roles:
# OTEL_SDK_DISABLED=true
